# Copy this file to config/config.properties and fill in your values.
# config/config.properties is gitignored — NEVER commit real credentials.

# From your Kite Connect app at developers.kite.trade (₹500/month plan
# needed for historical data)
kite.api_key=YOUR_API_KEY
kite.api_secret=YOUR_API_SECRET

# Local port that catches Zerodha's post-login redirect during the daily
# auth ritual. Register  http://127.0.0.1:5000/callback  as the Redirect URL
# of your Kite app (must match this port).
kite.redirect_port=5000

# Where the daily access token is stored (gitignored via "access_token*")
kite.token_path=config/access_token.properties

# Local SQLite database file
db.path=swingtrader.db

# Starting capital in rupees (used for backtests and sizing)
capital.starting=100000
